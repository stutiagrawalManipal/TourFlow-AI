# Copy this file to backend/.env and change the values. Never commit .env.

# ---- Database (PostgreSQL) ----
# Local install or Docker (see README "Database setup")
DATABASE_URL=postgres://tourflow:tourflow@localhost:5432/tourflow
# Set to true for hosted databases that require SSL (Render, Neon, Supabase ...)
DATABASE_SSL=false

# ---- Server ----
PORT=5000
# development | production
NODE_ENV=development
# Number of reverse proxies in front of the app (0 locally, usually 1 when hosted)
TRUST_PROXY=0
# Secure cookies need HTTPS. Leave empty to use: true in production, false in development
COOKIE_SECURE=
# How long a login stays valid (days)
SESSION_DAYS=7

# ---- First admin account (created on start-up if it does not exist) ----
# Use your own email and a strong password (8+ characters, letters and numbers).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password-123
ADMIN_NAME=TourFlow Admin

# ---- Photos ----
# Contact sent to Wikimedia by `npm run images:fetch` (their API policy requires it)
WIKIMEDIA_CONTACT=your-email@example.com

# ---- Limits (optional) ----
# Login/register attempts per IP per 15 minutes; bookings per user per minute
RATE_LIMIT_AUTH=30
RATE_LIMIT_BOOKINGS=10
