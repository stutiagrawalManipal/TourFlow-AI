# Copy this file to backend/.env and change the values. Never commit .env.

# Port for the backend API (frontend proxy must match - see root .env.example)
PORT=5000

# First admin account - created automatically on start-up if it does not exist.
# Use your own email and a strong password (min 8 characters).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=12345678
ADMIN_NAME=TourFlow Admin

# Where bookings, users and sessions are stored (relative to backend/)
DATA_FILE=data/tourflow-db.json

# How long a login stays valid
SESSION_DAYS=7
